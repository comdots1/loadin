{
  "manifest_version": 3,
  "name": "Loadin Browser Connector",
  "version": "2.2.0",
  "description": "Chrome, Edge, Whale, Brave, Opera, Vivaldi 등 모든 브라우저에서 다운로드 링크 클릭 시 Loadin 다운로드 창을 자동으로 연결합니다.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:17890/*",
    "http://localhost:17890/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Loadin 브라우저 연동",
    "default_popup": "popup.html"
  }
}
